# ---------------------------------------------------------------------------
# Nitte FPC Inventory — settings. Copy to ".env" for local use and fill in.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Supabase: Project → Connect → "Connection string" (replace [YOUR-PASSWORD]).
#   DATABASE_URL = Transaction pooler, port 6543  (used by the app on Vercel)
#   DIRECT_URL   = Session pooler,     port 5432  (used by migrations, seed and the MySQL import)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Local PostgreSQL instead: set DATABASE_URL only and leave DIRECT_URL empty, e.g.
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/nfpc_inventory

# --- App -------------------------------------------------------------------
# Public address of the app, used in password-reset emails, e.g. https://nfpc-inventory.vercel.app
# Blank = the address in the browser (only trusted for localhost).
APP_URL=

# --- Email for "Forgot password" links:  none | smtp | resend ---------------
#   none   — requests appear under Users & roles → Reset requests instead
#   smtp   — any SMTP server, e.g. Gmail with an App password
#   resend — https://resend.com HTTP API
MAIL_TRANSPORT=none
MAIL_FROM=
MAIL_FROM_NAME=Nitte FPC Inventory

# SMTP (Gmail: turn on 2-Step Verification, create an App password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# tls (STARTTLS, port 587) | ssl (port 465) | none
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Resend
RESEND_API_KEY=

# --- Only for `npm run import:mysql` (copying data from the old PHP/MySQL system) ---
MYSQL_URL=mysql://nfpc_app:PASSWORD@127.0.0.1:3306/nfpc_inventory
