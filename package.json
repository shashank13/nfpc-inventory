{
  "name": "nfpc-inventory",
  "version": "2.0.0",
  "private": true,
  "description": "Nitte FPC Inventory & barcode labelling (Next.js + Drizzle + PostgreSQL / Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "localdb:init": "node scripts/local-db.mjs init",
    "localdb:start": "node scripts/local-db.mjs start",
    "localdb:stop": "node scripts/local-db.mjs stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:samples": "tsx src/db/seed.ts --samples",
    "db:setup": "drizzle-kit migrate && tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "import:mysql": "tsx scripts/import-mysql.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "mysql2": "^3.24.6",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
