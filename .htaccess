# No directory listing
Options -Indexes

# Don't serve the SQL dump, include-only PHP files, hidden files or editor/backup copies
<FilesMatch "(?i)(\.sql|\.log|\.bak|\.old|\.orig|\.swp|\.tmp|\.ini|\.md|~|^db\.php|^auth\.php|^schema\.php|^mail\.php|^ui\.php|^\..*)$">
    Require all denied
</FilesMatch>

# Never show PHP errors to visitors (they reveal file paths); they still go to the PHP error log.
<IfModule php5_module>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag log_errors On
</IfModule>
<IfModule php7_module>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag log_errors On
</IfModule>

<IfModule mod_headers.c>
    # "set" (not "always set") replaces the same headers sent by PHP instead of duplicating them.
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "same-origin"
    # Browser-enforced allow-list: scripts/styles only from this site (+ the Excel reader on cdnjs),
    # data can only be sent back to this site, and the pages can't be framed by other sites.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set X-Permitted-Cross-Domain-Policies "none"
    # Don't advertise the PHP version.
    Header unset X-Powered-By
</IfModule>

DirectoryIndex index.php
